# 用法：cp .env.example .env，然后改里面的值
# JWT 密钥可以用这条命令生成一个：
#   python -c "import secrets;print(secrets.token_hex(32))"

MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=quizzy
MYSQL_PORT=3306

# Windows 下用正斜杠写盘符路径；dev 与 prod 共用，数据不会因切换运行方式而丢失
MYSQL_DATA_DIR=E:/develop/docker/mysql8/var/lib/mysql

QUIZZY_JWT_SECRET=please-replace-with-a-random-64-hex-string
QUIZZY_JWT_EXPIRE_DAYS=7
