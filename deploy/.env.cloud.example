# quizzy 云端 .env 模板 —— 放到服务器 /srv/quizzy/.env（chmod 600），供 docker-compose.prod.yml 读取。
#
#   cp deploy/.env.cloud.example /srv/quizzy/.env   # 然后逐项填值
#
# ⚠️ 这里**不放 APP_VERSION / APP_* 构建信息**——那些由 .github/workflows/release.yml
#    与 scripts/server-deploy.sh 在部署时传入（见 docs/adr/0015-version-number-governance.md）。
#
# JWT 密钥生成：python -c "import secrets;print(secrets.token_hex(32))"

TZ=Asia/Shanghai

# 数据与备份（Linux 绝对路径；容器里的 compose 用 --env-file 显式指向本文件）
MYSQL_DATA_DIR=/srv/quizzy/mysql
BACKUP_DIR=/srv/quizzy/backup
BACKUP_KEEP_DAYS=7

# MySQL：只在 compose 内部网络可达，不发布任何端口
MYSQL_ROOT_PASSWORD=please-replace-with-a-random-string
MYSQL_DATABASE=quizzy

# 阿里云 ACR：compose 的 image 前缀（服务器拉取用）。
# CI 推送用的凭据是另一套，放在 GitHub Secrets（ACR_USERNAME / ACR_PASSWORD）。
# ⚠️ 整段从控制台「仓库管理 → 访问凭证」抄。新个人版实例的地址形如
#    crpi-*.cn-<地域>.personal.cr.aliyuncs.com，与经典个人版的 registry.cn-<地域>.aliyuncs.com
#    是两种格式——不要照后者猜，抄错的表现是登录/拉取直接失败。
#    这个值必须与 .github/workflows/release.yml 的 env.ACR_REGISTRY 完全一致。
ACR_REGISTRY=crpi-1e1fwsxsm0ra0pky.cn-chengdu.personal.cr.aliyuncs.com
ACR_NAMESPACE=quizzy

# 应用
QUIZZY_JWT_SECRET=please-replace-with-a-random-64-hex-string
QUIZZY_JWT_EXPIRE_DAYS=7
# 前端与 /api 同源（宿主 nginx 把两者都反代到同一个容器），默认不需要 CORS。
# 只有出现跨域消费者时才填，逗号分隔；填了会以 allowCredentials=false 注册。
QUIZZY_CORS_ALLOWED_ORIGINS=
