{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": { "navigationBarTitleText": "Quizzy" }
    },
    {
      "path": "pages/login/index",
      "style": { "navigationBarTitleText": "登录 / 注册" }
    },
    {
      "path": "pages/quick/index",
      "style": { "navigationBarTitleText": "快速练习" }
    },
    {
      "path": "pages/quiz/index",
      "style": { "navigationBarTitleText": "答题" }
    },
    {
      "path": "pages/result/index",
      "style": { "navigationBarTitleText": "答题结果" }
    },
    {
      "path": "pages/wrongbook/index",
      "style": { "navigationBarTitleText": "错题本" }
    },
    {
      "path": "pages/history/index",
      "style": { "navigationBarTitleText": "答题记录" }
    },
    {
      "path": "pages/paper/index",
      "style": { "navigationBarTitleText": "试卷" }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "Quizzy",
    "navigationBarBackgroundColor": "#326AD9",
    "backgroundColor": "#EEF4FB"
  }
}
